            </Box>
            <Box style={{ width: 44, height: 64, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 26, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 240, height: 64, background: '#EDF4FC', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 17, color: '#276FBF' }}>制作与保存</Text>
            </Box>
            <Box style={{ width: 44, height: 64, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 26, color: '#26816B' }}>›</Text>
            </Box>
            <Box style={{ width: 240, height: 64, background: '#ECF7F2', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 17, color: '#26816B' }}>装配与核对</Text>
            </Box>
        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#546779' }}>5.3 作者资源与信息边界</Text>

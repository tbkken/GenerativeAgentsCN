                <Box style={{ width: 200, height: 82, background: '#ECF7F2', borderRadius: 10, padding: '12px 16px', flexDirection: 'column', gap: 4, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#26816B' }}>咨询台</Text>
                    <Text style={{ fontSize: 13, color: '#546779' }}>位于入口</Text>
                </Box>
                <Box style={{ width: 200, height: 82, background: '#ECF7F2', borderRadius: 10, padding: '12px 16px', flexDirection: 'column', gap: 4, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#26816B' }}>A 窗口</Text>
                    <Text style={{ fontSize: 13, color: '#546779' }}>位于 A 服务区</Text>
                </Box>
                <Box style={{ width: 200, height: 82, background: '#ECF7F2', borderRadius: 10, padding: '12px 16px', flexDirection: 'column', gap: 4, justifyContent: 'center' }}>

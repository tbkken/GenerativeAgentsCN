            <Text style={{ fontSize: 13, color: '#546779' }}>整图 20 × 16 格　·　草图矩形坐标</Text>

            <Box style={{ width: 396, height: 66, background: '#EDF4FC', borderRadius: 8, padding: '0 14px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#276FBF' }}>入口　咨询台</Text>
                <Text style={{ fontSize: 12, color: '#546779' }}>[1,1,18,3]</Text>
            </Box>

            <Box style={{ width: 396, height: 88, background: '#EDF4FC', borderRadius: 8, padding: '0 14px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#276FBF' }}>等候区</Text>
                <Text style={{ fontSize: 12, color: '#546779' }}>[1,4,18,4]</Text>
            </Box>

            <Box style={{ flexDirection: 'row' }}>
                <Box style={{ width: 198, height: 154, background: '#ECF7F2', borderRadius: 8, padding: 14, flexDirection: 'column', gap: 6 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#26816B' }}>A 服务区</Text>
                    <Text style={{ fontSize: 14, color: '#26816B' }}>A 窗口</Text>
                    <Text style={{ fontSize: 12, color: '#546779' }}>[1,8,9,7]</Text>
                </Box>
                <Box style={{ width: 198, height: 154, background: '#ECF7F2', borderRadius: 8, padding: 14, flexDirection: 'column', gap: 6 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#26816B' }}>B 服务区</Text>
                    <Text style={{ fontSize: 14, color: '#26816B' }}>B 窗口</Text>
                    <Text style={{ fontSize: 12, color: '#546779' }}>[10,8,9,7]</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ width: 640, flexDirection: 'column', justifyContent: 'center', gap: 14 }}>

            <Box style={{ width: 640, height: 84, background: '#F7F3E8', borderRadius: 10, padding: '0 22px', flexDirection: 'column', gap: 4, justifyContent: 'center' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#20344B' }}>World 青禾社区　›　Sector 便民服务站</Text>
                <Text style={{ fontSize: 14, color: '#546779' }}>下设入口、等候区、A 服务区、B 服务区四个 Arena</Text>
            </Box>

            <Box style={{ width: 640, height: 54, background: '#F4F7FA', borderRadius: 8, padding: '0 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B', width: 110 }}>入口</Text>
                <Text style={{ fontSize: 14, color: '#546779' }}>公共通道，人物从这里进入世界</Text>
            </Box>

            <Box style={{ width: 640, height: 54, background: '#F4F7FA', borderRadius: 8, padding: '0 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>

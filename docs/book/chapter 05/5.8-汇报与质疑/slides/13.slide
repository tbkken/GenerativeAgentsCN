            </Box>
            <Box style={{ width: 368, height: 72, background: '#ECF7F2', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 18, color: '#26816B' }}>口径：主要结论与全体一致</Text>
            </Box>
        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#546779' }}>5.8 汇报与质疑</Text>

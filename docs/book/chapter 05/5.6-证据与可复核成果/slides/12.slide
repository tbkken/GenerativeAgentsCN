        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 14, color: '#546779' }}>5.6.3　保持相同的取材边界</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#20344B' }}>窗口在 Step76 结束</Text>
        </Box>
    </Box>

    <Box style={{ height: 540, flexDirection: 'column', justifyContent: 'center', gap: 8 }}>

        <Box style={{ flexDirection: 'row' }}>

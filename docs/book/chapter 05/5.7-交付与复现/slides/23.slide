                <Box style={{ width: 676, height: 58, background: '#FFFFFF', borderRadius: 8, padding: '0 16px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 4, height: 28, background: '#276FBF' }} />
                    <Text style={{ fontSize: 16, color: '#546779' }}>接收者应知道缺哪项材料、如何继续</Text>
                </Box>

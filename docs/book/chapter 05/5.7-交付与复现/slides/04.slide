            <Box style={{ width: 240, height: 300, background: '#F4F7FA', borderRadius: 10, padding: '16px 14px', flexDirection: 'column', gap: 8 }}>
                <Box style={{ width: 44, height: 44, background: '#CB6B28', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>跑</Text>
                </Box>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#20344B' }}>重新执行</Text>
                <Text style={{ fontSize: 14, color: '#546779', lineHeight: 1.6 }}>此环境能否继续工作：输入、依赖、凭据与预算</Text>
                <Box style={{ width: 212, height: 30, background: '#FFF4E6', borderRadius: 6, justifyContent: 'center', alignItems: 'center', marginTop: 4 }}>

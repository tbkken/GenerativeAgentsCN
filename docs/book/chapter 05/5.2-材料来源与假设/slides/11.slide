                <Text style={{ fontSize: 24, color: '#CB6B28' }}>↓</Text>
            </Box>
            <Box style={{ width: 678 }} />
            <Box style={{ width: 44, height: 48, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#CB6B28' }}>↓</Text>
            </Box>
            <Box style={{ width: 193 }} />
        </Box>

        <Box style={{ width: 1152, flexDirection: 'row', justifyContent: 'center' }}>
            <Box style={{ width: 620, height: 92, background: '#FFF4E6', borderRadius: 10, padding: '0 24px', flexDirection: 'column', gap: 4, justifyContent: 'center' }}>
                <Text style={{ fontSize: 14, color: '#CB6B28' }}>C01　冲突登记</Text>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#20344B' }}>咨询扩大为审批，任务与判据都会改变</Text>
            </Box>
        </Box>

        <Box style={{ width: 1152, height: 40, flexDirection: 'row', justifyContent: 'center', alignItems: 'center' }}>

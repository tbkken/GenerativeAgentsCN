        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 14, color: '#546779' }}>5.9.4　选对副本，才能改对地方</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#20344B' }}>公共资源、草稿、封存与 Run</Text>
        </Box>
    </Box>

    <Box style={{ height: 540, flexDirection: 'row', alignItems: 'center', gap: 32 }}>

        <Box style={{ width: 640, flexDirection: 'column' }}>

            <Box style={{ width: 640, height: 80, background: '#F7F3E8', borderRadius: 10, padding: '0 20px', flexDirection: 'column', justifyContent: 'center', gap: 2 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#20344B' }}>公共资源　直接编辑</Text>
                <Text style={{ fontSize: 14, color: '#546779' }}>影响未来新选入的项目</Text>
            </Box>

            <Box style={{ width: 640, height: 40, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <Box style={{ width: 460, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 20, color: '#276FBF' }}>↓</Text>
                </Box>
                <Text style={{ fontSize: 13, color: '#546779', width: 166 }}>选入时完整复制</Text>
            </Box>

            <Box style={{ width: 640, height: 80, background: '#EDF4FC', borderRadius: 10, padding: '0 20px', flexDirection: 'column', justifyContent: 'center', gap: 2 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#276FBF' }}>独立实验草稿　DRAFT</Text>
                <Text style={{ fontSize: 14, color: '#546779' }}>包内副本可以编辑</Text>
            </Box>

            <Box style={{ width: 640, height: 40, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <Box style={{ width: 460, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 20, color: '#276FBF' }}>↓</Text>
                </Box>
                <Text style={{ fontSize: 13, color: '#546779', width: 166 }}>封存</Text>
            </Box>

            <Box style={{ width: 640, height: 80, background: '#ECF7F2', borderRadius: 10, padding: '0 20px', flexDirection: 'column', justifyContent: 'center', gap: 2 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#26816B' }}>SEALED　当前输入不可修改</Text>
                <Text style={{ fontSize: 14, color: '#546779' }}>需要调整时复制成新的独立草稿</Text>
            </Box>

            <Box style={{ width: 640, height: 40, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <Box style={{ width: 460, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 20, color: '#26816B' }}>↓</Text>
                </Box>
                <Text style={{ fontSize: 13, color: '#546779', width: 166 }}>启动时完整嵌入</Text>
            </Box>

            <Box style={{ width: 640, height: 80, background: '#F4F7FA', borderRadius: 10, padding: '0 20px', flexDirection: 'column', justifyContent: 'center', gap: 2 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#20344B' }}>Run 内嵌实验</Text>
                <Text style={{ fontSize: 14, color: '#546779' }}>固定本次执行输入</Text>
            </Box>

        </Box>

        <Box style={{ width: 480, flexDirection: 'column', gap: 16 }}>
            <Box style={{ width: 480, height: 152, background: '#FFF4E6', borderRadius: 10, padding: '18px 20px', flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#CB6B28' }}>公共修改不自动更新旧实验</Text>
                <Text style={{ fontSize: 15, color: '#546779', lineHeight: 1.6 }}>改了公共 Skill，既有实验里的那一份副本仍然是旧内容。</Text>

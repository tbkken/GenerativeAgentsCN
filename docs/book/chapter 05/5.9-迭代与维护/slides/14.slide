            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#20344B' }}>知识块 ③</Text>
        </Box>
    </Box>

    <Box style={{ height: 540, flexDirection: 'column', justifyContent: 'center', gap: 16 }}>

        <Text style={{ fontSize: 96, fontWeight: 'bold', color: '#276FBF', lineHeight: 1.0 }}>③</Text>

        <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#20344B', lineHeight: 1.15 }}>选对副本，才能改对地方</Text>

        <Box style={{ width: 72, height: 4, background: '#276FBF' }} />

        <Text style={{ fontSize: 18, color: '#546779', lineHeight: 1.7, width: 940 }}>同一份内容会被复制成多份。沿复制边界看哪些副本仍保留原内容，才知道这一次编辑落在哪一件材料上。</Text>

        <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 10 }}>

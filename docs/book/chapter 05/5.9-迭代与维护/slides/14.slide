                <Text style={{ fontSize: 26, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 254, height: 68, background: '#ECF7F2', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 17, color: '#26816B' }}>封存实验</Text>
            </Box>
            <Box style={{ width: 44, height: 68, justifyContent: 'center', alignItems: 'center' }}>

                <Box style={{ width: 560, height: 72, background: '#F4F7FA', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                    <Text style={{ fontSize: 14, color: '#546779', width: 110 }}>运行证据</Text>
                    <Text style={{ fontSize: 16, color: '#20344B' }}>全部 Run 与判分</Text>
                </Box>
                <Box style={{ width: 560, height: 72, background: '#F4F7FA', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                    <Text style={{ fontSize: 14, color: '#546779', width: 110 }}>接收范围</Text>

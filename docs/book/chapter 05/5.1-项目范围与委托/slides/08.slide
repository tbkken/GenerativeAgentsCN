                <Box style={{ width: 560, height: 72, background: '#F4F7FA', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                    <Text style={{ fontSize: 14, color: '#546779', width: 110 }}>问题与方法</Text>
                    <Text style={{ fontSize: 16, color: '#20344B' }}>范围、判据、计划</Text>
                </Box>
                <Box style={{ width: 560, height: 72, background: '#F4F7FA', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                    <Text style={{ fontSize: 14, color: '#546779', width: 110 }}>输入材料</Text>
                    <Text style={{ fontSize: 16, color: '#20344B' }}>精确文字与依赖</Text>
                </Box>
                <Box style={{ width: 560, height: 72, background: '#F4F7FA', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                    <Text style={{ fontSize: 14, color: '#546779', width: 110 }}>运行证据</Text>
                    <Text style={{ fontSize: 16, color: '#20344B' }}>明确待执行</Text>
                </Box>
                <Box style={{ width: 560, height: 72, background: '#F4F7FA', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                    <Text style={{ fontSize: 14, color: '#546779', width: 110 }}>接收范围</Text>
                    <Text style={{ fontSize: 16, color: '#20344B' }}>纸面审读</Text>
                </Box>
            </Box>

            <Box style={{ width: 560, flexDirection: 'column', gap: 8 }}>
                <Box style={{ width: 560, height: 44, background: '#ECF7F2', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#26816B' }}>运行交付　再要求真实配置与全部 Run</Text>
                </Box>
                <Box style={{ width: 560, height: 72, background: '#F4F7FA', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                    <Text style={{ fontSize: 14, color: '#546779', width: 110 }}>问题与方法</Text>
                    <Text style={{ fontSize: 16, color: '#20344B' }}>同样需要</Text>
                </Box>
                <Box style={{ width: 560, height: 72, background: '#F4F7FA', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                    <Text style={{ fontSize: 14, color: '#546779', width: 110 }}>输入材料</Text>
                    <Text style={{ fontSize: 16, color: '#20344B' }}>实际保存的实验副本</Text>

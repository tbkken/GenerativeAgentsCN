            <Box style={{ width: 620, height: 104, background: '#F4F7FA', borderRadius: 8, padding: '0 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Box style={{ width: 4, height: 62, background: '#276FBF' }} />
                <Box style={{ width: 560, flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 16, color: '#20344B' }}>完整作者材料可以支持配置</Text>
                    <Text style={{ fontSize: 15, color: '#CB6B28' }}>不能证明运行稳定</Text>
                </Box>
            </Box>

            <Box style={{ width: 620, height: 104, background: '#F4F7FA', borderRadius: 8, padding: '0 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Box style={{ width: 4, height: 62, background: '#276FBF' }} />
                <Box style={{ width: 560, flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 16, color: '#20344B' }}>运行已结束可以开始分析</Text>
                    <Text style={{ fontSize: 15, color: '#CB6B28' }}>不能自动证明业务成功</Text>
                </Box>
            </Box>

            <Box style={{ width: 620, height: 88, background: '#ECF7F2', borderRadius: 10, padding: '0 20px', justifyContent: 'center' }}>
                <Text style={{ fontSize: 16, color: '#26816B', lineHeight: 1.55 }}>这些判断能减少返工，也使进度报告更诚实。</Text>
            </Box>

        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>

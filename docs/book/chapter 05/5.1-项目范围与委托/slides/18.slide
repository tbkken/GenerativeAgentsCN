            <Box style={{ width: 155, flexDirection: 'column', gap: 8 }}>
                <Box style={{ width: 155, height: 130, background: '#ECF7F2', borderRadius: 10, padding: '14px 12px', flexDirection: 'column', gap: 6 }}>
                    <Text style={{ fontSize: 13, color: '#546779' }}>环节五</Text>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#26816B' }}>接收复查</Text>
                    <Text style={{ fontSize: 13, color: '#546779', lineHeight: 1.45 }}>实际文件、约定验证范围</Text>
                </Box>
                <Box style={{ width: 155, height: 62, background: '#F4F7FA', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, color: '#20344B' }}>接收记录</Text>
                </Box>
            </Box>

            <Box style={{ width: 44, height: 130, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#26816B' }}>›</Text>

                    <Text style={{ fontSize: 13, color: '#546779', lineHeight: 1.45 }}>问题、范围、判据</Text>
                </Box>
                <Box style={{ width: 155, height: 62, background: '#F4F7FA', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, color: '#20344B' }}>委托书</Text>
                </Box>
            </Box>

            <Box style={{ width: 44, height: 130, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#276FBF' }}>›</Text>
            </Box>

            <Box style={{ width: 155, flexDirection: 'column', gap: 8 }}>
                <Box style={{ width: 155, height: 130, background: '#EDF4FC', borderRadius: 10, padding: '14px 12px', flexDirection: 'column', gap: 6 }}>
                    <Text style={{ fontSize: 13, color: '#546779' }}>环节二</Text>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#276FBF' }}>准备输入</Text>
                    <Text style={{ fontSize: 13, color: '#546779', lineHeight: 1.45 }}>来源、信息边界与精确 Skill</Text>
                </Box>
                <Box style={{ width: 155, height: 62, background: '#F4F7FA', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>

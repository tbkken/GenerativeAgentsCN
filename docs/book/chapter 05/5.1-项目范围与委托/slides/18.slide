            </Box>

            <Box style={{ width: 155, flexDirection: 'column', gap: 8 }}>
                <Box style={{ width: 155, height: 130, background: '#EDF4FC', borderRadius: 10, padding: '14px 12px', flexDirection: 'column', gap: 6 }}>
                    <Text style={{ fontSize: 13, color: '#546779' }}>环节三</Text>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#276FBF' }}>配置执行</Text>
                    <Text style={{ fontSize: 13, color: '#546779', lineHeight: 1.45 }}>保存、身份、预算与全部 Run</Text>

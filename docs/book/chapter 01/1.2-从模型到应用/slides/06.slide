                    <Box style={{ width: 4, height: 44, background: '#CB6B28' }} />
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#CB6B28' }}>校验与控制</Text>
                </Box>
                <Box style={{ flex: 1 }}><Text style={{ fontSize: 16, color: '#20344B', lineHeight: 1.6 }}>检查约束，安排修正、停止或人工处理</Text></Box>
                <Box style={{ width: 250 }}><Text style={{ fontSize: 16, color: '#CB6B28', lineHeight: 1.6 }}>校验报告与失败原因</Text></Box>
            </Box>

        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#546779' }}>1.2 从模型到应用</Text>
        <Text style={{ fontSize: 14, color: '#546779' }}>06 / 22</Text>

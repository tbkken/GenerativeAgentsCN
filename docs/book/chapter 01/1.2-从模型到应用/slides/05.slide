                    <Text style={{ fontSize: 16, color: '#20344B' }}>10 人，房间容量 12 人</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 2 }}>
                    <Text style={{ fontSize: 14, color: '#546779' }}>怎样判断</Text>
                    <Text style={{ fontSize: 16, color: '#276FBF' }}>10 ≤ 12</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', height: 84, background: '#F4F7FA', borderRadius: 10, padding: '0 18px', alignItems: 'center', gap: 16 }}>

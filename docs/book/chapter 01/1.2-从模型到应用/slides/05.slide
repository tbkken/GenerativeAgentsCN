        </Box>

        <Box style={{ width: 420, flexDirection: 'column', justifyContent: 'center', gap: 14 }}>

            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#20344B' }}>核对结果</Text>

            <Box style={{ height: 132, background: '#FFF4E6', border: '2px solid #CB6B28', borderRadius: 10, padding: '18px 20px', flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#CB6B28' }}>10:00—10:30　冲突</Text>
                <Text style={{ fontSize: 16, color: '#546779', lineHeight: 1.6 }}>整段落在已有预约内，不能使用</Text>
            </Box>

            <Box style={{ height: 132, background: '#ECF7F2', border: '2px solid #26816B', borderRadius: 10, padding: '18px 20px', flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#26816B' }}>10:30—11:00　满足</Text>
                <Text style={{ fontSize: 16, color: '#546779', lineHeight: 1.6 }}>五项条件全部通过，可以使用</Text>
            </Box>

            <Box style={{ background: '#F4F7FA', borderRadius: 10, padding: '16px 20px', flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>还要再看一层</Text>
                <Text style={{ fontSize: 15, color: '#546779', lineHeight: 1.6 }}>应用还须检查候选方案内各活动之间是否冲突。</Text>
            </Box>

        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>

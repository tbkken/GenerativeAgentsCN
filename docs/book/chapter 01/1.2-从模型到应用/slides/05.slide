                    <Text style={{ fontSize: 14, color: '#546779' }}>教学设定</Text>
                    <Text style={{ fontSize: 16, color: '#20344B' }}>连续 30 分钟</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 2 }}>
                    <Text style={{ fontSize: 14, color: '#546779' }}>怎样判断</Text>

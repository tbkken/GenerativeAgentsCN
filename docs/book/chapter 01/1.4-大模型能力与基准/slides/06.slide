                    <Box style={{ width: 4, height: 40, background: '#CB6B28' }} />
                    <Text style={{ fontSize: 14, color: '#CB6B28', lineHeight: 1.45 }}>差异来自协议与快照日期，不是模型忽然变强</Text>
                </Box>
            </Box>

        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#546779' }}>1.4 从榜单到证据</Text>
        <Text style={{ fontSize: 14, color: '#546779' }}>06 / 36</Text>
    </Box>

</Slide>

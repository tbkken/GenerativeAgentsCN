        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 14, color: '#546779' }}>④　1.4.4　样本展示：从两三个例子里推出规则</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#20344B' }}>ARC-AGI-2：看例子推规则</Text>
        </Box>
    </Box>


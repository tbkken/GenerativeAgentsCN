                    <Text style={{ width: 80, fontSize: 18, fontWeight: 'bold', color: '#CB6B28' }}>43</Text>
                    <Text style={{ fontSize: 14, color: '#CB6B28', lineHeight: 1.4 }}>第 4 层：研究级，私有题集</Text>
                </Box>
                <Box style={{ flex: 1 }} />
                <Text style={{ fontSize: 13, color: '#546779', lineHeight: 1.4 }}>官方成绩默认用私有集</Text>
            </Box>

        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#546779' }}>1.4 从榜单到证据</Text>

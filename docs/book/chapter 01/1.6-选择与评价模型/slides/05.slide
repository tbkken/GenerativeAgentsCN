            <Box style={{ width: 540, paddingLeft: 12 }}><Text style={{ fontSize: 15, color: '#546779' }}>容量、预约、人数等关键字段有依据</Text></Box>
            <Box style={{ width: 422, paddingLeft: 12 }}><Text style={{ fontSize: 15, color: '#20344B' }}>与输入材料逐项核对</Text></Box>
        </Box>

        <Box style={{ height: 84, background: '#F4F7FA', borderRadius: 8, flexDirection: 'row', alignItems: 'center' }}>
            <Box style={{ width: 4, height: 44, background: '#276FBF' }} />
            <Box style={{ width: 186, paddingLeft: 14 }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>约束满足</Text></Box>
            <Box style={{ width: 540, paddingLeft: 12 }}><Text style={{ fontSize: 15, color: '#546779' }}>时间、容量、时长和相互冲突处理正确</Text></Box>
            <Box style={{ width: 422, paddingLeft: 12 }}><Text style={{ fontSize: 15, color: '#20344B' }}>人工或确定性程序检查</Text></Box>
        </Box>

        <Box style={{ height: 84, background: '#FFF4E6', borderRadius: 8, flexDirection: 'row', alignItems: 'center' }}>
            <Box style={{ width: 4, height: 44, background: '#CB6B28' }} />
            <Box style={{ width: 186, paddingLeft: 14 }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#CB6B28' }}>信息不足</Text></Box>
            <Box style={{ width: 540, paddingLeft: 12 }}><Text style={{ fontSize: 15, color: '#546779' }}>缺失内容明确，未编造必要事实</Text></Box>
            <Box style={{ width: 422, paddingLeft: 12 }}><Text style={{ fontSize: 15, color: '#20344B' }}>与预设缺失项清单核对</Text></Box>
        </Box>

        <Box style={{ height: 84, background: '#F4F7FA', borderRadius: 8, flexDirection: 'row', alignItems: 'center' }}>

                <Box style={{ flexDirection: 'column', gap: 2 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#CB6B28' }}>有出处</Text>
                    <Text style={{ fontSize: 15, color: '#546779' }}>自报还是维护方公布，未披露项照写</Text>
                </Box>
            </Box>
        </Box>

    </Box>

</Slide>

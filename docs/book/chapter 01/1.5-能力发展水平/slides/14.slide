            <Box style={{ width: 56, height: 56, borderRadius: 10, background: '#276FBF', justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#FFFFFF' }}>04</Text>
            </Box>
            <Text style={{ fontSize: 16, color: '#546779' }}>1.5.4</Text>
        </Box>

        <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#20344B', lineHeight: 1.15 }}>高分背后包含执行环境</Text>

        <Box style={{ width: 640, height: 4, background: '#276FBF' }} />

        <Text style={{ fontSize: 19, color: '#546779', lineHeight: 1.7 }}>条件未知就写未披露，不把不同设置排成一条进步曲线。</Text>

        <Box style={{ marginTop: 8, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ flex: 1, height: 58, background: '#F4F7FA', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>

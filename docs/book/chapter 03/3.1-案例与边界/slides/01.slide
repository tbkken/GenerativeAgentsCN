                    </Box>
                </Box>
                <Box style={{ width: 520, height: 62, background: '#FFF4E6', borderRadius: 8, padding: '8px 14px', flexDirection: 'column', gap: 2, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#CB6B28' }}>10:00 手作室已有预约</Text>
                    <Text style={{ fontSize: 13, color: '#546779' }}>原消息需要经真实渠道修正，而不是被谁提前知道</Text>
                </Box>
            </Box>
        </Box>

    </Box>

</Slide>

                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B', width: 72 }}>林岚</Text>
                    <Text style={{ fontSize: 15, color: '#276FBF', width: 108 }}>公共大厅</Text>
                    <Box style={{ flex: 1, height: 28, background: '#EDF4FC', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 13, color: '#276FBF' }}>坐标 · 地址 · 已知空间</Text>
                    </Box>
                </Box>
                <Box style={{ width: 584, height: 56, background: '#FFFFFF', borderRadius: 8, padding: '0 14px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B', width: 72 }}>周宁</Text>
                    <Text style={{ fontSize: 15, color: '#276FBF', width: 108 }}>手作室</Text>
                    <Box style={{ flex: 1, height: 28, background: '#EDF4FC', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 13, color: '#276FBF' }}>坐标 · 地址 · 已知空间</Text>
                    </Box>
                </Box>

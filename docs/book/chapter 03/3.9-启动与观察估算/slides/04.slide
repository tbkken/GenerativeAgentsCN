            <Box style={{ width: 480, height: 78, background: '#FFF4E6', borderRadius: 10, padding: '0 16px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Box style={{ width: 4, height: 46, background: '#CB6B28' }} />
                <Text style={{ fontSize: 14, color: '#546779', flex: 1, lineHeight: 1.5 }}>预检通过只说明输入可用，不等于运行已经开始。</Text>

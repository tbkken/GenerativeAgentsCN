                <Text style={{ fontSize: 24, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 195, height: 64, background: '#EDF4FC', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, color: '#276FBF' }}>运行</Text>
            </Box>
            <Box style={{ width: 44, height: 64, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 195, height: 64, background: '#EDF4FC', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, color: '#276FBF' }}>收尾</Text>

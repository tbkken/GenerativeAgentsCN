                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>检查点 / 恢复快照</Text>
                <Text style={{ fontSize: 13, color: '#546779' }}>发布完整状态</Text>
            </Box>
            <Box style={{ width: 44, height: 116, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 26, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 253, height: 116, background: '#F4F7FA', borderRadius: 8, padding: 12, flexDirection: 'column', gap: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>推进可见状态</Text>
                <Text style={{ fontSize: 13, color: '#546779' }}>与 committed_step</Text>
            </Box>
            <Box style={{ width: 44, height: 116, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 26, color: '#26816B' }}>›</Text>
            </Box>
            <Box style={{ width: 253, height: 116, background: '#ECF7F2', borderRadius: 8, padding: 12, flexDirection: 'column', gap: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#26816B' }}>Replay</Text>
                <Text style={{ fontSize: 13, color: '#546779' }}>只读已提交边界</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 24 }}>
            <Box style={{ width: 680, height: 76, background: '#EDF4FC', borderRadius: 10, padding: '0 20px', justifyContent: 'center' }}>
                <Text style={{ fontSize: 15, color: '#20344B', lineHeight: 1.5 }}>Event 加上非空 structured_payload，才支持确定性重建</Text>
            </Box>
            <Box style={{ width: 448, height: 76, background: '#FFF4E6', borderRadius: 10, padding: '0 20px', justifyContent: 'center' }}>
                <Text style={{ fontSize: 15, color: '#CB6B28', lineHeight: 1.5 }}>Thought、计划与临时文本：不进入回放归约</Text>
            </Box>
        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#546779' }}>3.11 回放事实与失败诊断</Text>
        <Text style={{ fontSize: 14, color: '#546779' }}>04 / 27</Text>

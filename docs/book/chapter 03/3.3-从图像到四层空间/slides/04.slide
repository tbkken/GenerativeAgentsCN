                <Box style={{ flex: 1 }} />
                <Text style={{ fontSize: 13, color: '#FFFFFF' }}>覆盖整张 32×24 地图</Text>
            </Box>
        </Box>

        <Box style={{ height: 20, justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ fontSize: 18, color: '#276FBF' }}>↓</Text>

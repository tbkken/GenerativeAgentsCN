            </Box>

            <Box style={{ width: 260, height: 50, background: '#26816B', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>交流桌</Text>
            </Box>

            <Box style={{ width: 260, height: 50, flexDirection: 'row', gap: 12 }}>
                <Box style={{ width: 124, height: 50, background: '#26816B', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>公告栏</Text>

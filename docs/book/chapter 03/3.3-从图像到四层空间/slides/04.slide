                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#276FBF' }}>阅读室</Text>
                <Text style={{ fontSize: 13, color: '#546779', lineHeight: 1.5 }}>适合阅读与分享</Text>
                <Text style={{ fontSize: 12, color: '#546779' }}>X 1 · Y 1 · W 10 · H 12</Text>

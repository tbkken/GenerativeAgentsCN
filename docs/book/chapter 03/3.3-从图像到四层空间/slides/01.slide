                        </Box>
                    </Box>
                    <Box style={{ flexDirection: 'row' }}>
                        <Box style={{ width: 186, height: 10, background: '#B5C7D8' }} />
                        <Box style={{ width: 28, height: 10, background: '#CB6B28' }} />
                        <Box style={{ width: 144, height: 10, background: '#B5C7D8' }} />
                        <Box style={{ width: 28, height: 10, background: '#CB6B28' }} />
                        <Box style={{ width: 114, height: 10, background: '#B5C7D8' }} />
                    </Box>
                    <Box style={{ width: 500, height: 44, background: '#ECF7F2', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>

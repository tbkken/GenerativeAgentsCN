                <Text style={{ fontSize: 15, color: '#FFFFFF' }}>基础配置　·　智能体　·　新建智能体</Text>
                <Box style={{ width: 76, height: 22, background: '#FFFFFF', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>

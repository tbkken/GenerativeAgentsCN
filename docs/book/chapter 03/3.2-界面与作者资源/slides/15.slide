        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 14, color: '#546779' }}>3.2.4　用 Crowd 组织一次选择</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#20344B' }}>人群工作区：三步完成一次选择</Text>
        </Box>
    </Box>


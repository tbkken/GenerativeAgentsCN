                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#20344B' }}>林岚</Text>
                <Text style={{ fontSize: 14, color: '#546779' }}>组织者</Text>
            </Box>
            <Box style={{ width: 268, height: 76, background: '#EDF4FC', borderRadius: 8, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 3 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#20344B' }}>周宁</Text>
                <Text style={{ fontSize: 14, color: '#546779' }}>志愿者</Text>
            </Box>
            <Box style={{ width: 268, height: 76, background: '#EDF4FC', borderRadius: 8, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 3 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#20344B' }}>陈晨</Text>
                <Text style={{ fontSize: 14, color: '#546779' }}>阅读访客</Text>
            </Box>
            <Box style={{ width: 268, height: 76, background: '#EDF4FC', borderRadius: 8, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 3 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#20344B' }}>许安</Text>
                <Text style={{ fontSize: 14, color: '#546779' }}>手作访客</Text>

                    <Text style={{ fontSize: 15, color: '#276FBF' }}>稳定 ID</Text>
                </Box>
                <Box style={{ width: 300, height: 56, background: '#EDF4FC', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, color: '#276FBF' }}>内容摘要</Text>
                </Box>
                <Box style={{ width: 300, height: 56, background: '#ECF7F2', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, color: '#26816B' }}>实验装配</Text>

                    <Text style={{ fontSize: 15, color: '#CB6B28' }}>别混在一起</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ width: 568, flexDirection: 'column', gap: 8 }}>

            <Box style={{ width: 568, height: 44, background: '#276FBF', borderRadius: 8, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 16px' }}>

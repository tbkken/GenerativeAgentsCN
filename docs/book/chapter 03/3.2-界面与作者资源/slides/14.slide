            <Box style={{ width: 140, height: 56, background: '#EDF4FC', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, color: '#20344B' }}>许安</Text>
            </Box>
            <Box style={{ width: 44, height: 56, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 26, color: '#26816B' }}>›</Text>
            </Box>
            <Box style={{ width: 320, height: 56, background: '#ECF7F2', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, color: '#26816B' }}>人群「开放日四人」</Text>

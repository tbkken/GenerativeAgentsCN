                        <Text style={{ fontSize: 20, color: '#26816B' }}>›</Text>
                    </Box>
                    <Box style={{ width: 296, height: 56, background: '#ECF7F2', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#26816B' }}>qinghe-helpdesk</Text>
                    </Box>
                </Box>
                <Box style={{ width: 428, height: 66, background: '#FFFFFF', borderRadius: 8, padding: '10px 14px', flexDirection: 'column', gap: 3, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#26816B' }}>各有对象身份</Text>
                    <Text style={{ fontSize: 13, color: '#546779' }}>只能修改自身状态；不接在 Brain 依赖后面，不是必经步骤</Text>
                </Box>
            </Box>

        </Box>

        <Box style={{ flexDirection: 'row', gap: 32 }}>
            <Box style={{ width: 560, height: 96, background: '#ECF7F2', borderRadius: 10, flexDirection: 'row', alignItems: 'center', padding: '0 18px', gap: 14 }}>
                <Box style={{ width: 4, height: 52, background: '#26816B' }} />
                <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#26816B' }}>子 Skill 不能 world-act</Text>
                    <Text style={{ fontSize: 14, color: '#546779' }}>本案例两个子 Skill 也不写记忆，保持纯建议角色</Text>
                </Box>
            </Box>
            <Box style={{ width: 560, height: 96, background: '#EDF4FC', borderRadius: 10, flexDirection: 'row', alignItems: 'center', padding: '0 18px', gap: 14 }}>
                <Box style={{ width: 4, height: 52, background: '#276FBF' }} />
                <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#276FBF' }}>依赖表示可调用关系，不是固定顺序</Text>
                    <Text style={{ fontSize: 14, color: '#546779' }}>公告栏与服务台各自运行，不构成 Brain 的必经步骤</Text>
                </Box>
            </Box>
        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>

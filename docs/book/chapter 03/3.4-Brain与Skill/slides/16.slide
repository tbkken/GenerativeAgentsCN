                <Box style={{ width: 440, flexDirection: 'column', gap: 8 }}>
                    <Box style={{ width: 440, height: 38, background: '#FFFFFF', borderRadius: 6, flexDirection: 'row', alignItems: 'center', padding: '0 12px', gap: 10 }}>

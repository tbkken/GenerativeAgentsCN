                    </Box>
                    <Text style={{ fontSize: 12, color: '#546779', marginTop: 2 }}>SKILL.md 编辑区</Text>
                    <Box style={{ width: 440, height: 172, background: '#20344B', borderRadius: 6, padding: '12px 14px', flexDirection: 'column', gap: 7 }}>
                        <Text style={{ fontSize: 12, color: '#B5C7D8' }}>---</Text>
                        <Text style={{ fontSize: 12, color: '#FFFFFF' }}>name: qinghe-compare-options</Text>

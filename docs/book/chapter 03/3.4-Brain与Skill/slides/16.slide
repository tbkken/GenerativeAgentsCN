                <Box style={{ width: 140, background: '#EDF4FC', borderRadius: 8, padding: 10, flexDirection: 'column', gap: 6 }}>
                    <Box style={{ width: 120, height: 26, background: '#276FBF', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 12, color: '#FFFFFF' }}>技能</Text>
                    </Box>
                    <Box style={{ width: 120, height: 26, background: '#FFFFFF', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>

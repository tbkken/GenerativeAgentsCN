                    </Box>
                    <Box style={{ width: 120, height: 26, background: '#FFFFFF', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 12, color: '#546779' }}>模型</Text>

                <Text style={{ fontSize: 14, color: '#FFFFFF' }}>资源中心　·　技能</Text>
                <Box style={{ width: 70, height: 20, background: '#FFFFFF', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 11, color: '#276FBF' }}>示意</Text>
                </Box>
            </Box>


                <Text style={{ fontSize: 15, color: '#546779', lineHeight: 1.6 }}>Brain 属于实验运行装配，对象技能属于地图的 Game Object。</Text>
            </Box>

        </Box>

        <Box style={{ width: 620, flexDirection: 'column', justifyContent: 'center', gap: 12 }}>

            <Box style={{ width: 620, height: 40, background: '#276FBF', borderRadius: 10, borderBottomLeftRadius: 0, borderBottomRightRadius: 0, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 14px' }}>

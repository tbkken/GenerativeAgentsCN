                <Text style={{ fontSize: 24, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 180, height: 74, background: '#EDF4FC', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#276FBF' }}>Step 41</Text>
            </Box>
            <Box style={{ width: 44, height: 74, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#26816B' }}>›</Text>
            </Box>
            <Box style={{ width: 180, height: 74, background: '#ECF7F2', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#26816B' }}>Step 48</Text>
            </Box>
            <Box style={{ width: 44, height: 74, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#CB6B28' }}>›</Text>
            </Box>
            <Box style={{ width: 220, height: 74, background: '#FFF4E6', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#CB6B28' }}>11:30 手作结束</Text>
            </Box>
        </Box>

        <Text style={{ fontSize: 14, color: '#546779' }}>轴上的节点间距是示意，不是实测耗时；最右侧落在观察窗口之外。</Text>

        <Box style={{ width: 1152, height: 88, background: '#F4F7FA', borderRadius: 10, padding: '0 20px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 4, height: 48, background: '#276FBF' }} />
            <Box style={{ width: 200 }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#20344B' }}>足以检验什么</Text>
            </Box>
            <Box style={{ flexDirection: 'column' }}>
                <Text style={{ fontSize: 14, color: '#546779' }}>信息获取、公告变化与后续行动的时间窗口设计。</Text>
            </Box>

        <Box style={{ width: 1152, height: 72, background: '#F7F3E8', borderRadius: 10, padding: '0 20px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 4, height: 44, background: '#20344B' }} />
            <Text style={{ fontSize: 15, color: '#546779' }}>结果记录应写「本窗口内观察到什么」，不要用剧本计划填补尚未发生的部分。</Text>
        </Box>


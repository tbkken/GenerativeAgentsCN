        <Box style={{ width: 1152, height: 88, background: '#F4F7FA', borderRadius: 10, padding: '0 20px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 4, height: 48, background: '#CB6B28' }} />
            <Box style={{ width: 200 }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#20344B' }}>不能证明什么</Text>
            </Box>
            <Box style={{ flexDirection: 'column' }}>
                <Text style={{ fontSize: 14, color: '#546779' }}>不保证模型一定完成这些环节，也不覆盖十一点半的手作结束。</Text>
            </Box>

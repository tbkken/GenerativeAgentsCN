                    <Text style={{ fontSize: 20, color: '#276FBF' }}>↓</Text>
                </Box>
                <Box style={{ width: 428, height: 62, background: '#276FBF', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>调用 world-act</Text>
                </Box>
                <Box style={{ width: 428, height: 26, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 20, color: '#CB6B28' }}>↓</Text>
                </Box>
                <Box style={{ width: 428, height: 76, background: '#FFF4E6', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, color: '#CB6B28', lineHeight: 1.4 }}>成功接受？是：立即结束本轮，不能再补写完成记忆</Text>
                </Box>
                <Box style={{ width: 428, height: 62, background: '#FFFFFF', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, color: '#546779' }}>否：保留不确定性，依据错误与调用预算处理</Text>
                </Box>
            </Box>

            <Box style={{ width: 44, height: 420, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 26, color: '#276FBF' }}>›</Text>
            </Box>

            <Box style={{ width: 144, height: 420, background: '#F7F3E8', borderRadius: 12, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, color: '#20344B', lineHeight: 1.8 }}>世界执行{'\n'}与{'\n'}整步持久提交</Text>
            </Box>

            <Box style={{ width: 44, height: 420, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 26, color: '#276FBF' }}>›</Text>
            </Box>

            <Box style={{ width: 460, height: 420, background: '#F4F7FA', borderRadius: 12, padding: '16px 16px', flexDirection: 'column', gap: 10 }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#20344B' }}>下一轮</Text>
                <Box style={{ width: 428, height: 62, background: '#EDF4FC', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, color: '#276FBF' }}>读取实际坐标、活动、对象状态或答复</Text>
                </Box>
                <Box style={{ width: 428, height: 26, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 20, color: '#26816B' }}>↓</Text>

            <Box style={{ width: 194, height: 68, background: '#ECF7F2', borderRadius: 10, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, color: '#26816B' }}>下一轮反馈</Text>

                <Text style={{ fontSize: 24, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 194, height: 68, background: '#FFF4E6', borderRadius: 10, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, color: '#CB6B28' }}>对象回复</Text>
            </Box>
            <Box style={{ width: 44, height: 68, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 194, height: 68, background: '#EDF4FC', borderRadius: 10, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, color: '#276FBF' }}>整步提交</Text>
            </Box>
            <Box style={{ width: 44, height: 68, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#26816B' }}>›</Text>

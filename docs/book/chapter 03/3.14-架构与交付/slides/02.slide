            <Box style={{ height: 66, background: '#FFF4E6', borderRadius: 8, padding: '0 16px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <Box style={{ width: 32, height: 32, background: '#CB6B28', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>5</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 2 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>一份实验交付物应包含什么</Text>
                    <Text style={{ fontSize: 13, color: '#546779' }}>八个位置，每个位置回答一个读者问题</Text>
                </Box>

            <Box style={{ width: 520, height: 356, background: '#EDF4FC', borderRadius: 12, padding: '20px 22px', flexDirection: 'column', gap: 12 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#276FBF' }}>Brain / Skill 决定方法</Text>
                <Box style={{ height: 1, background: '#B5C7D8' }} />
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>

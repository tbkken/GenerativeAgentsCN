                        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                    </Box>
                    <Text style={{ fontSize: 15, color: '#20344B', flex: 1 }}>怎样使用证据与选择动作</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 26, height: 26, background: '#276FBF', borderRadius: 13, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                    </Box>
                    <Text style={{ fontSize: 15, color: '#20344B', flex: 1 }}>何时等待或结束本轮</Text>
                </Box>
                <Box style={{ height: 62, background: '#FFFFFF', borderRadius: 8, padding: '0 16px', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 14, color: '#546779' }}>ReAct / 反思 / 排程 都是可选方法，不是人人必走的内核流水线</Text>
                </Box>
            </Box>

            <Box style={{ width: 112, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 8 }}>

                <Text style={{ fontSize: 26, color: '#276FBF' }}>›</Text>
                <Text style={{ fontSize: 12, color: '#CB6B28', textAlign: 'center' }}>必经此处</Text>
            </Box>

            <Box style={{ width: 520, height: 356, background: '#ECF7F2', borderRadius: 12, padding: '20px 22px', flexDirection: 'column', gap: 12 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#26816B' }}>内核守住公共边界</Text>
                <Box style={{ height: 1, background: '#B5C7D8' }} />

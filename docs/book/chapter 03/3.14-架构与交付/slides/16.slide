        </Box>

        <Box style={{ height: 84, background: '#FFF4E6', borderRadius: 10, padding: '0 22px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Box style={{ width: 4, height: 54, background: '#CB6B28' }} />
            <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#CB6B28' }}>方法变化不绕过身份、权限或提交</Text>

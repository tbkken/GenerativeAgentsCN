        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 14, color: '#546779' }}>3.14.4　Brain 决定做法，内核守住事实边界</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#20344B' }}>方法可变，内核守住事实边界</Text>
        </Box>
    </Box>

    <Box style={{ height: 540, flexDirection: 'column', justifyContent: 'center', gap: 16 }}>


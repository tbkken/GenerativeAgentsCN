                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#276FBF' }}>四条私有限制</Text>
                <Text style={{ fontSize: 14, color: '#546779', lineHeight: 1.5 }}>F1、F2、F3、F4 逐条削减</Text>
            </Box>
            <Box style={{ width: 44, height: 116, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 26, color: '#26816B' }}>›</Text>
            </Box>
            <Box style={{ width: 284, height: 116, background: '#ECF7F2', borderRadius: 10, padding: '16px 20px', flexDirection: 'column', gap: 6, justifyContent: 'center' }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#26816B' }}>唯一解</Text>
                <Text style={{ fontSize: 14, color: '#546779', lineHeight: 1.5 }}>只剩一种安排</Text>
            </Box>
        </Box>

        <Box style={{ width: 1152, height: 84, background: '#F4F7FA', borderRadius: 10, padding: '12px 20px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 4, height: 44, background: '#276FBF' }} />
            <Box style={{ width: 200, height: 44, justifyContent: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#276FBF' }}>F2 · 任新</Text>
            </Box>
            <Text style={{ fontSize: 14, color: '#20344B', lineHeight: 1.5, flex: 1 }}>固定拼图 11 点 → 拼图的时段不再有选择</Text>
        </Box>

        <Box style={{ width: 1152, height: 84, background: '#F4F7FA', borderRadius: 10, padding: '12px 20px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 4, height: 44, background: '#276FBF' }} />
            <Box style={{ width: 200, height: 44, justifyContent: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#276FBF' }}>F1 · 温乔</Text>
            </Box>
            <Text style={{ fontSize: 14, color: '#20344B', lineHeight: 1.5, flex: 1 }}>阅读先、手作后 → 剩余两时段的次序确定</Text>

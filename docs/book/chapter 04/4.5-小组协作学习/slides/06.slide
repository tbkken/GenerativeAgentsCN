                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#26816B' }}>温乔　私有 F1</Text>
                <Text style={{ fontSize: 13, color: '#546779' }}>阅读早于手作</Text>
            </Box>
            <Box style={{ width: 368, height: 96, background: '#ECF7F2', borderRadius: 8, padding: '12px 16px', flexDirection: 'column', gap: 4, justifyContent: 'center' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#26816B' }}>任新　私有 F2</Text>
                <Text style={{ fontSize: 13, color: '#546779' }}>拼图 11:00 开始</Text>
            </Box>
            <Box style={{ width: 368, height: 96, background: '#ECF7F2', borderRadius: 8, padding: '12px 16px', flexDirection: 'column', gap: 4, justifyContent: 'center' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#26816B' }}>白露　私有 F3、F4</Text>
                <Text style={{ fontSize: 13, color: '#546779' }}>手作→操作室；阅读→阅览室</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 24, height: 40 }}>
            <Box style={{ width: 368, height: 40, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, color: '#26816B' }}>↓ 真实双人 SPEAK</Text>
            </Box>
            <Box style={{ width: 368, height: 40, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, color: '#26816B' }}>↓ 真实双人 SPEAK</Text>
            </Box>
            <Box style={{ width: 368, height: 40, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, color: '#26816B' }}>↓ 真实双人 SPEAK</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 24, height: 100 }}>
            <Box style={{ width: 368, height: 100, background: '#F7F3E8', borderRadius: 8, padding: '12px 16px', flexDirection: 'column', gap: 4, justifyContent: 'center' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#20344B' }}>共同题面</Text>
                <Text style={{ fontSize: 13, color: '#546779', lineHeight: 1.5 }}>三活动各 50 分钟{'\n'}三时段、三教室各一次</Text>
            </Box>
            <Box style={{ width: 44, height: 100, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 692, height: 100, background: '#EDF4FC', borderRadius: 8, padding: '12px 16px', flexDirection: 'column', gap: 4, justifyContent: 'center' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#276FBF' }}>陶明　主持人　初始 0 条</Text>
                <Text style={{ fontSize: 13, color: '#546779', lineHeight: 1.5 }}>无私有限制、无教师答案；保存实际取得的条件与来源，并据此提出候选</Text>

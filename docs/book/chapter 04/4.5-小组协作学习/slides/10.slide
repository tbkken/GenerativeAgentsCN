                    </Box>
                    <Text style={{ fontSize: 15, color: '#20344B', lineHeight: 1.55, flex: 1 }}>被询问时真实 SPEAK，向一人说明条件编号、完整限制与来源</Text>
                </Box>
                <Box style={{ width: 560, height: 104, background: '#FFF4E6', borderRadius: 10, padding: '14px 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>

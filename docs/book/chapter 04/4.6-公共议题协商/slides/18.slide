                <Box style={{ height: 52, background: '#FFFFFF', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, color: '#546779' }}>候选 D　·　三人逐人征询</Text>
                </Box>
                <Box style={{ height: 52, background: '#FFFFFF', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, color: '#546779' }}>理由 R1—R5 逐条登记</Text>
                </Box>
                <Box style={{ height: 52, background: '#FFF4E6', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#CB6B28' }}>未形成一致意见</Text>

                <Text style={{ fontSize: 14, color: '#26816B' }}>＝ 100%</Text>
            </Box>
            <Box style={{ width: 276, height: 130, background: '#F7F3E8', borderRadius: 10, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 6 }}>
                <Text style={{ fontSize: 14, color: '#546779' }}>保留事项记录</Text>

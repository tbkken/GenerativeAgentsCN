                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#276FBF' }}>R3</Text>
                        <Text style={{ fontSize: 15, color: '#20344B', lineHeight: 1.5 }}>希望口头交流；静默可保留，但不能称交流需求已满足</Text>
                    </Box>
                </Box>

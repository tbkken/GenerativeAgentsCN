        <Box style={{ height: 118, background: '#FFF4E6', borderRadius: 10, padding: '0 22px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 4, height: 72, background: '#CB6B28' }} />
            <Box style={{ flexDirection: 'column', gap: 6, flex: 1 }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#CB6B28' }}>三人对同一候选均明确同意，才记一致</Text>
                <Text style={{ fontSize: 15, color: '#546779', lineHeight: 1.5 }}>保留、反对、未回应都如实对应到人；主持人不能临时改成多数通过，也不能替谁声明态度。</Text>
            </Box>
        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#546779' }}>4.6 公共议题协商</Text>
        <Text style={{ fontSize: 14, color: '#546779' }}>05 / 24</Text>
    </Box>

</Slide>

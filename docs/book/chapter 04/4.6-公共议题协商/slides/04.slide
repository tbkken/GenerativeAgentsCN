            </Box>

        </Box>

        <Box style={{ height: 76, background: '#FFF4E6', borderRadius: 10, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 22px' }}>
            <Box style={{ width: 4, height: 44, background: '#CB6B28' }} />
            <Text style={{ fontSize: 16, color: '#546779', lineHeight: 1.6, flex: 1 }}>符合场地规则，不等于满足个人需求；符合规则只说明候选没有被共同规则排除，不能替任何人表示同意。</Text>
        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>

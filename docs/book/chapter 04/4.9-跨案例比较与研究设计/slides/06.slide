            <Box style={{ width: 90 }}><Text style={{ fontSize: 14, color: '#546779' }}>未闭环</Text></Box>
            <Box style={{ width: 110 }}><Text style={{ fontSize: 14, color: '#546779' }}>逻辑调用</Text></Box>
            <Box style={{ width: 110 }}><Text style={{ fontSize: 14, color: '#546779' }}>物理尝试</Text></Box>

                    <Box style={{ width: 34, height: 44, justifyContent: 'flex-end' }}><Box style={{ width: 34, height: 6, background: '#D7E2EC', borderRadius: 3 }} /></Box>
                    <Box style={{ width: 34, height: 44, justifyContent: 'flex-end' }}><Box style={{ width: 34, height: 6, background: '#D7E2EC', borderRadius: 3 }} /></Box>

                    <Text style={{ fontSize: 14, color: '#FFF4E6' }}>午夜·当地日期变化</Text>
                </Box>
                <Box style={{ width: 44, height: 88, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 24, color: '#276FBF' }}>›</Text>
                </Box>
                <Box style={{ width: 184, height: 88, background: '#EDF4FC', borderRadius: 8, flexDirection: 'column', gap: 4, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#276FBF' }}>10-20 08:00</Text>
                    <Text style={{ fontSize: 14, color: '#546779' }}>Step145 窗口末</Text>

                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#20344B' }}>形成说明</Text>
            </Box>
            <Box style={{ width: 44, height: 100, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 192, height: 100, background: '#EDF4FC', borderRadius: 8, flexDirection: 'column', gap: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 12, color: '#546779' }}>第 3 步</Text>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#20344B' }}>提交并确认</Text>
            </Box>
            <Box style={{ width: 44, height: 100, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 192, height: 100, background: '#EDF4FC', borderRadius: 8, flexDirection: 'column', gap: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 12, color: '#546779' }}>第 4 步</Text>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#20344B' }}>真实通知</Text>
            </Box>
            <Box style={{ width: 44, height: 100, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 24, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 192, height: 100, background: '#ECF7F2', borderRadius: 8, flexDirection: 'column', gap: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 12, color: '#546779' }}>第 5 步</Text>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#20344B' }}>回应问题</Text>
            </Box>
        </Box>

        <Box style={{ height: 120, background: '#EDF4FC', borderRadius: 10, padding: '0 24px', flexDirection: 'row', alignItems: 'center', gap: 22 }}>
            <Text style={{ fontSize: 88, fontWeight: 'bold', color: '#276FBF', lineHeight: 1.0 }}>2</Text>
            <Box style={{ flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#20344B' }}>唯一差异落在第 2 步：怎么整理这份说明</Text>

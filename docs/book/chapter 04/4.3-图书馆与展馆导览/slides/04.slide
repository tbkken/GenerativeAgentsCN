                    <Box style={{ flex: 1 }}><Text style={{ fontSize: 15, fontWeight: 'bold', color: '#546779' }}>匹配活动</Text></Box>
                </Box>

                <Box style={{ height: 58, background: '#FFFFFF', borderRadius: 8, flexDirection: 'row', alignItems: 'center', gap: 14, padding: '0 14px' }}>
                    <Box style={{ width: 4, height: 32, background: '#276FBF' }} />
                    <Box style={{ width: 92 }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>安禾 G1</Text></Box>
                    <Box style={{ width: 300 }}><Text style={{ fontSize: 15, color: '#546779' }}>辨认城市常见鸟类外形</Text></Box>
                    <Box style={{ flex: 1 }}><Text style={{ fontSize: 15, color: '#546779' }}>阅读／观看鸟类图册</Text></Box>
                </Box>

                <Box style={{ height: 58, background: '#FFFFFF', borderRadius: 8, flexDirection: 'row', alignItems: 'center', gap: 14, padding: '0 14px' }}>
                    <Box style={{ width: 4, height: 32, background: '#276FBF' }} />
                    <Box style={{ width: 92 }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>罗宁 G2</Text></Box>
                    <Box style={{ width: 300 }}><Text style={{ fontSize: 15, color: '#546779' }}>了解鸟类活动记录方法</Text></Box>
                    <Box style={{ flex: 1 }}><Text style={{ fontSize: 15, color: '#546779' }}>阅读鸟类观察记录</Text></Box>
                </Box>

                <Box style={{ height: 58, background: '#FFFFFF', borderRadius: 8, flexDirection: 'row', alignItems: 'center', gap: 14, padding: '0 14px' }}>

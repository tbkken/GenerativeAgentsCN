                    <Box style={{ width: 92 }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>姚知 G3</Text></Box>
                    <Box style={{ width: 300 }}><Text style={{ fontSize: 15, color: '#546779' }}>比较传统纸艺纹样</Text></Box>
                    <Box style={{ flex: 1 }}><Text style={{ fontSize: 15, color: '#546779' }}>观看／阅读纹样资料</Text></Box>

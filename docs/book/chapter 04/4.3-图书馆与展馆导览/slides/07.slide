                            </Box>
                            <Box style={{ height: 64, background: '#F4F7FA', justifyContent: 'center', alignItems: 'center' }}>
                                <Text style={{ fontSize: 14, color: '#546779' }}>入口</Text>
                            </Box>
                        </Box>
                        <Box style={{ width: 16, background: '#F4F7FA' }} />
                    </Box>
                    <Box style={{ height: 96, flexDirection: 'row' }}>
                        <Box style={{ width: 16, background: '#F4F7FA' }} />
                        <Box style={{ width: 160, height: 96, background: '#EDF4FC', justifyContent: 'center', alignItems: 'center' }}>
                            <Text style={{ fontSize: 14, color: '#276FBF' }}>甲厅</Text>
                        </Box>
                        <Box style={{ width: 192, height: 96, background: '#ECF7F2', justifyContent: 'center', alignItems: 'center' }}>

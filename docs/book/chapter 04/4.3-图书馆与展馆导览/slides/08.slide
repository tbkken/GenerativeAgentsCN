            <Box style={{ background: '#F4F7FA', borderRadius: 10, padding: '16px 18px', flexDirection: 'column', gap: 10 }}>
                <Text style={{ fontSize: 16, color: '#20344B', lineHeight: 1.5 }}>World「青禾社区」→ Sector「主题馆」</Text>
                <Text style={{ fontSize: 16, color: '#546779', lineHeight: 1.5 }}>网格 24 × 18，边界封闭、内部连通</Text>

        <Box style={{ width: 72, height: 4, background: '#276FBF' }} />

        <Box style={{ flexDirection: 'row', gap: 24, marginTop: 6 }}>

            <Box style={{ width: 368, height: 236, background: '#EDF4FC', borderRadius: 12, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 8, padding: '0 20px' }}>

            <Box style={{ width: 1000, height: 84, background: '#EDF4FC', borderRadius: 10, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 22px' }}>
                <Box style={{ width: 38, height: 38, background: '#276FBF', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#276FBF' }}>谁真的收到了</Text>
                    <Text style={{ fontSize: 15, color: '#546779' }}>覆盖率是多少，未接收者有没有单列、有没有被填窗口长度。</Text>
                </Box>
            </Box>

            <Box style={{ width: 1000, height: 84, background: '#ECF7F2', borderRadius: 10, flexDirection: 'row', alignItems: 'center', gap: 18, padding: '0 22px' }}>
                <Box style={{ width: 38, height: 38, background: '#26816B', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#26816B' }}>我数的是行动还是人</Text>
                    <Text style={{ fontSize: 15, color: '#546779' }}>分母是相关动作；零过期不等于传播全面，要同时看覆盖率。</Text>
                </Box>
            </Box>

        </Box>

        <Text style={{ fontSize: 14, color: '#546779', marginTop: 6 }}>青禾读写交流为虚构教案，尚无实验或 Run；本节全部数值口径均为预登记设定。</Text>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>

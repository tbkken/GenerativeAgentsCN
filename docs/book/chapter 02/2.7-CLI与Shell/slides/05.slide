        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 14, color: '#546779' }}>2.7.1　读懂一条命令的六个部分</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#20344B' }}>六项要素，各自记录什么</Text>
        </Box>
    </Box>

    <Box style={{ height: 540, flexDirection: 'row', gap: 32 }}>


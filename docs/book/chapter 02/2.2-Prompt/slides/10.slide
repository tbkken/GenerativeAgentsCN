                        <Box style={{ width: 4, height: 26, background: '#CB6B28' }} />
                        <Text style={{ fontSize: 16, color: '#20344B' }}>遗漏了本该安排的活动</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>

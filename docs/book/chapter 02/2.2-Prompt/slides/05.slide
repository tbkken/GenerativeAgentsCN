                </Box>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 16, color: '#20344B', lineHeight: 1.45 }}>四份材料文件，预约状态另行查询</Text>
                </Box>
            </Box>

            <Box style={{ height: 78, background: '#F4F7FA', borderRadius: 10, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Box style={{ width: 4, height: 46, background: '#276FBF' }} />
                <Box style={{ width: 170 }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#20344B' }}>哪些必须满足</Text>
                </Box>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 16, color: '#20344B', lineHeight: 1.45 }}>日期、开放时间、容量、时长、允许房间、已有预约</Text>
                </Box>
            </Box>

            <Box style={{ height: 78, background: '#F4F7FA', borderRadius: 10, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Box style={{ width: 4, height: 46, background: '#276FBF' }} />
                <Box style={{ width: 170 }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#20344B' }}>输出是什么</Text>
                </Box>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 16, color: '#20344B', lineHeight: 1.45 }}>约束清单、候选方案、依据和未解决事项</Text>
                </Box>
            </Box>

            <Box style={{ height: 78, background: '#FFF4E6', borderRadius: 10, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Box style={{ width: 4, height: 46, background: '#CB6B28' }} />
                <Box style={{ width: 170 }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#CB6B28' }}>什么不能假设</Text>
                </Box>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 16, color: '#20344B', lineHeight: 1.45 }}>未查询不等于无预约；没有资料不等于没有限制</Text>
                </Box>
            </Box>

            <Box style={{ height: 78, background: '#ECF7F2', borderRadius: 10, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>

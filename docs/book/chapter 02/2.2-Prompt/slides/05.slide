        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 14, color: '#546779' }}>2.2.1　六个问题构成一份任务说明</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#20344B' }}>青禾的六个具体答案</Text>
        </Box>
    </Box>

    <Box style={{ height: 540, flexDirection: 'row', alignItems: 'center', gap: 32 }}>

        <Box style={{ width: 700, flexDirection: 'column', justifyContent: 'center', gap: 8 }}>

            <Box style={{ height: 78, background: '#F4F7FA', borderRadius: 10, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Box style={{ width: 4, height: 46, background: '#276FBF' }} />

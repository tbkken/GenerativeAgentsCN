                    <Box style={{ width: 6, height: 28, background: '#276FBF' }} />
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#20344B' }}>输入</Text>
                </Box>
                <Text style={{ fontSize: 14, color: '#546779' }}>依据哪些材料</Text>
                <Text style={{ fontSize: 15, color: '#20344B', lineHeight: 1.55 }}>brief.md、rooms.csv、rules.md、requests.csv，预约另行查询</Text>
            </Box>
            <Box style={{ width: 370, background: '#EDF4FC', borderRadius: 12, padding: '18px 22px', flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 6, height: 28, background: '#276FBF' }} />
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#20344B' }}>约束</Text>
                </Box>
                <Text style={{ fontSize: 14, color: '#546779' }}>必须满足什么</Text>
                <Text style={{ fontSize: 15, color: '#20344B', lineHeight: 1.55 }}>日期、开放时间、容量、活动时长、允许房间、已有预约</Text>
            </Box>

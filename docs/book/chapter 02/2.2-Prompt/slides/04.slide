        <Box style={{ flexDirection: 'row', gap: 20, height: 180 }}>
            <Box style={{ width: 370, background: '#ECF7F2', borderRadius: 12, padding: '18px 22px', flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 6, height: 28, background: '#26816B' }} />
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#20344B' }}>输出</Text>

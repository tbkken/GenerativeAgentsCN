                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#276FBF' }}>独立任务</Text>
                <Text style={{ fontSize: 14, color: '#546779' }}>看不到之前的对话</Text>
            </Box>
            <Box style={{ width: 44, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 26, color: '#276FBF' }}>›</Text>
            </Box>
            <Box style={{ width: 300, height: 76, background: '#ECF7F2', borderRadius: 8, justifyContent: 'center', alignItems: 'center', flexDirection: 'column', gap: 2 }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#26816B' }}>指出还需读哪些文件</Text>

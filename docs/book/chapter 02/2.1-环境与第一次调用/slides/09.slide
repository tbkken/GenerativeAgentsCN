        </Box>

        <Box style={{ flexDirection: 'row', height: 100, background: '#F4F7FA', borderRadius: 10, padding: '16px 22px', alignItems: 'center', gap: 24, marginTop: 6 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <Box style={{ width: 4, height: 56, background: '#CB6B28' }} />

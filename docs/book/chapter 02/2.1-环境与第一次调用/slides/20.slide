            </Box>
            <Box style={{ width: 72 }} />
            <Box style={{ width: 440, height: 108, background: '#ECF7F2', borderRadius: 10, padding: '14px 18px', flexDirection: 'column', gap: 4, justifyContent: 'center' }}>

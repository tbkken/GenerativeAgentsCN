            <Box style={{ width: 400, height: 140, background: '#ECF7F2', borderRadius: 8, padding: '14px 16px', flexDirection: 'column', gap: 6, justifyContent: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#26816B' }}>team-report.md</Text>
                <Text style={{ fontSize: 14, color: '#546779', lineHeight: 1.55 }}>唯一写最终报告的步骤</Text>
            </Box>
            <Box style={{ width: 16 }} />
            <Box style={{ width: 244, height: 140, background: '#FFF4E6', borderRadius: 8, padding: '14px 16px', flexDirection: 'column', gap: 6, justifyContent: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#CB6B28' }}>不自行改写已验收的排期</Text>
                <Text style={{ fontSize: 14, color: '#546779', lineHeight: 1.55 }}>汇总不等于重做决定</Text>
            </Box>
        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>

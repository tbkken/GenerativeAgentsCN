            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Box style={{ width: 440, height: 140, background: '#EDF4FC', borderRadius: 8, padding: '14px 16px', flexDirection: 'column', gap: 6, justifyContent: 'center' }}>

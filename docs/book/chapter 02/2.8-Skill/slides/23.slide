                <Text style={{ fontSize: 13, color: '#546779' }}>真实命令与真实输出</Text>
            </Box>
            <Box style={{ width: 264, height: 92, background: '#ECF7F2', borderRadius: 8, padding: '14px 16px', flexDirection: 'column', gap: 6, justifyContent: 'center' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#26816B' }}>通过了没有</Text>
                <Text style={{ fontSize: 13, color: '#546779' }}>候选文件与业务报告</Text>

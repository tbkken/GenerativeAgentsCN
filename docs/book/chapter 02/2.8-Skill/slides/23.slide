                <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#FFFFFF' }}>05</Text>
            </Box>
            <Text style={{ fontSize: 16, color: '#546779' }}>2.8.6–2.8.7</Text>
        </Box>

        <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#20344B', lineHeight: 1.15 }}>取证、复用与边界</Text>

        <Box style={{ width: 640, height: 4, background: '#276FBF' }} />

        <Text style={{ fontSize: 19, color: '#546779', lineHeight: 1.7 }}>安装完成不是证据，安装成功之后还要逐项取证。</Text>

        <Box style={{ marginTop: 8, flexDirection: 'row', gap: 32 }}>
            <Box style={{ width: 264, height: 92, background: '#EDF4FC', borderRadius: 8, padding: '14px 16px', flexDirection: 'column', gap: 6, justifyContent: 'center' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#276FBF' }}>装上了没有</Text>

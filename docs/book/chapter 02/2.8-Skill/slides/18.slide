            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#20344B' }}>三条路线不能互相套用</Text>
        </Box>
    </Box>

    <Box style={{ height: 540, flexDirection: 'column', justifyContent: 'center', gap: 16 }}>


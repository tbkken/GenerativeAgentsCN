            <Box style={{ height: 72, background: '#F4F7FA', borderRadius: 8, padding: '0 16px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Box style={{ width: 4, height: 44, background: '#276FBF' }} />
                <Box style={{ width: 220, flexDirection: 'column', gap: 3 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>Skill</Text>
                    <Text style={{ fontSize: 12, color: '#546779' }}>做法需要重复使用</Text>
                </Box>
                <Box style={{ width: 44, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 18, color: '#276FBF' }}>›</Text></Box>
                <Text style={{ flex: 1, fontSize: 13, color: '#546779', lineHeight: 1.5 }}>是否正确选用 SOP、脚本与验收步骤</Text>
            </Box>

        </Box>

    </Box>

    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#546779' }}>2.14 技术选择与完整交付</Text>

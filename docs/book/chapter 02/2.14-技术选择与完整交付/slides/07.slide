            <Box style={{ width: 260, flexDirection: 'column', gap: 3 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>Agent 循环</Text>
                <Text style={{ fontSize: 12, color: '#546779' }}>下一步依赖未知结果</Text>
            </Box>
            <Box style={{ width: 44, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 18, color: '#26816B' }}>›</Text></Box>
            <Text style={{ flex: 1, fontSize: 14, color: '#546779', lineHeight: 1.5 }}>是否根据观察调整，并在边界内停止</Text>

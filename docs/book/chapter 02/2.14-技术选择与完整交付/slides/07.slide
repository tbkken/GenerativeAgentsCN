        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 14, color: '#546779' }}>2.14.1　按问题选择技术</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#20344B' }}>扩展路线的五种技术，以及组合方式</Text>
        </Box>
    </Box>

    <Box style={{ height: 540, flexDirection: 'column', justifyContent: 'center', gap: 16 }}>


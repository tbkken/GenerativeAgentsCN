            <Box style={{ width: 260, flexDirection: 'column', gap: 3 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>多模态与计算机工具</Text>
                <Text style={{ fontSize: 12, color: '#546779' }}>需要读图、听录音或操作页面</Text>
            </Box>
            <Box style={{ width: 44, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 18, color: '#26816B' }}>›</Text></Box>
            <Text style={{ flex: 1, fontSize: 14, color: '#546779', lineHeight: 1.5 }}>感知、执行和最终状态是否分别核实</Text>
        </Box>

        <Box style={{ height: 72, background: '#F4F7FA', borderRadius: 8, padding: '0 20px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>

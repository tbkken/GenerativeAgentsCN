            <Box style={{ width: 4, height: 44, background: '#26816B' }} />
            <Box style={{ width: 260, flexDirection: 'column', gap: 3 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#20344B' }}>检索与 RAG</Text>
                <Text style={{ fontSize: 12, color: '#546779' }}>资料很多，不能全部放入上下文</Text>

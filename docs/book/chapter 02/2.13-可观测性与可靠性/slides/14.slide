                </Box>
                <Text style={{ fontSize: 16, color: '#20344B', lineHeight: 1.5 }}>除预约外，全部硬约束都通过</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#276FBF', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#20344B', lineHeight: 1.5 }}>七次避开预约冲突，三次发生冲突</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#CB6B28', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>4</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#CB6B28', lineHeight: 1.5 }}>其中两次没有生成最终说明文件</Text>
            </Box>
            <Box style={{ width: 512, height: 1, background: '#B5C7D8' }} />
            <Text style={{ fontSize: 15, color: '#546779', lineHeight: 1.6 }}>三个数字各有各的分母，说的不是同一件事。</Text>
        </Box>

        <Box style={{ width: 560, flexDirection: 'column', gap: 16 }}>

            <Box style={{ width: 560, height: 150, background: '#EDF4FC', borderRadius: 10, padding: '0 24px', flexDirection: 'row', alignItems: 'center', gap: 20 }}>
